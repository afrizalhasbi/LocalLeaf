{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalLeaf",
  "version": "1.0.0",
  "identifier": "me.aliperti.texcraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalLeaf",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first LaTeX editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright \u00a9 2026 leoaliperti. MIT License.",
    "publisher": "leoaliperti",
    "homepage": "https://github.com/leoaliperti/LocalLeaf",
    "longDescription": "LocalLeaf is a local-first LaTeX editor with an Overleaf-style interface. It compiles with the TeX engines installed on your computer, keeps projects as plain folders, and doubles as an MCP server for AI agents.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
